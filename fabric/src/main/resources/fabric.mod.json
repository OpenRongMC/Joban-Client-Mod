{
  "schemaVersion": 1,
  "id": "rongmc_jsblock",
  "version": "${version}",
  "name": "Joban Client Mod",
  "description": "Railway facilities addon for MTR 4 mod",
  "authors": [
    "LX86"
  ],
  "contributors": [
    "1081MTR",
    "AozoraSky",
    "StrikeSNC",
    "Dooji",
    "Jonathan Ho",
    "CinderaceOTS"
  ],
  "contact": {
    "homepage": "https://www.joban.org/jcm",
